{
  "name": "opus-workspace",
  "private": true,
  "type": "module",
  "description": "Dev tooling only (tests, type check, screenshots). The game and the voxel garden ship as static files from web/.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "serve": "python3 -m http.server 8080 --directory web",
    "shot": "node tools/garden-shot.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^25.0.0",
    "typescript": "~5.9.3"
  }
}
